PORT=4000
JWT_SECRET=konkou_dev_secret_change_in_production
POINTS_TO_HTG_RATE=0.08

# Retraits (cash pickup chez l'agent)
MIN_CASHOUT_HTG=500
MAX_DAILY_CASHOUT_HTG=10000
PICKUP_LOCATION_INFO=Présentez ce code à votre agent pour recevoir votre argent en espèces.

# Frais de service sur les retraits, par palier de montant (HTG) — prélevé sur ce que
# l'utilisateur reçoit en espèces, entièrement pour la plateforme (n'affecte pas la
# commission de l'agent, calculée séparément sur le montant brut).
CASHOUT_FEE_TIER1_MAX_HTG=2000
CASHOUT_FEE_TIER1_PERCENT=5
CASHOUT_FEE_TIER2_MAX_HTG=5000
CASHOUT_FEE_TIER2_PERCENT=6
CASHOUT_FEE_TIER3_PERCENT=8

# Dépôts (achat de parties bonus chez l'agent — jamais convertible en espèces)
MIN_DEPOSIT_HTG=100
MAX_DEPOSIT_HTG=2500
HTG_PER_BONUS_PLAY=50
DEPOSIT_LOCATION_INFO=Présentez ce code et votre paiement à votre agent pour recevoir vos parties bonus.

# Réseau d'agents : capital requis pour devenir agent, part gardée par la plateforme,
# et commission touchée par l'agent sur chaque retrait qu'il paie.
AGENT_CAPITAL_HTG=7500
AGENT_CAPITAL_FEE_PERCENT=10
AGENT_CASHOUT_COMMISSION_PERCENT=10

# Renflouement agent (capital additionnel après l'inscription) : plafond de chaque
# renflouement = ce pourcentage de plus que le dépôt précédent, frais plateforme prélevé
# sur le montant déposé, montant minimum d'une demande.
AGENT_REFILL_GROWTH_PERCENT=25
AGENT_REFILL_FEE_PERCENT=7
AGENT_REFILL_MIN_HTG=100

# Vérification par WhatsApp (remplace l'envoi de SMS, pas encore de fournisseur configuré).
# Numéro de l'opérateur qui reçoit les messages de confirmation, format E.164 SANS le "+"
# (ex: un numéro haïtien 3712-3456 -> 50937123456). OBLIGATOIRE : sans lui, personne ne
# peut finaliser une inscription ou une réinitialisation de mot de passe.
OPERATOR_WHATSAPP_NUMBER=50900000000

ADMIN_PASSWORD=changeme_admin_password
